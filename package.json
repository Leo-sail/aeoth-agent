{
  "name": "@deepseek-ai/dsh-root",
  "version": "0.2.1-alpha.3",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "workspaces": [
    "vendor/*",
    "packages/*/*",
    "native/system",
    "native/system/packages/*",
    "apps/desktop",
    "apps/desktop-host"
  ],
  "scripts": {
    "prepare:primary-runtime": "tsx scripts/primary-runtime/prepare.ts",
    "build": "tsx scripts/build.ts",
    "build:official": "echo \"build:official: skipped (lib already built)\"",
    "build:lib": "pnpm run build:lib:host && pnpm run build:lib:client",
    "build:lib:host": "node --max-old-space-size=6144 ./node_modules/typescript/bin/tsc -b tsconfig.host.json && tsdown --config packages/util/package-manifest/tsdown.config.ts && node --max-old-space-size=6144 ./node_modules/tsdown/dist/run.mjs --env.DSH_BUILD_FACE host && pnpm --filter @deepseek-ai/dsh-desktop run bundle",
    "build:lib:client": "tsc -b tsconfig.client.json && tsdown --env.DSH_BUILD_FACE client",
    "build:desktop": "pnpm --filter @deepseek-ai/dsh-desktop run build",
    "dev:desktop": "pnpm --filter @deepseek-ai/dsh-desktop run dev",
    "start:desktop": "pnpm --filter @deepseek-ai/dsh-desktop run start",
    "prepare:desktop": "pnpm --filter @deepseek-ai/dsh-desktop run prepare:package",
    "package:desktop": "pnpm --filter @deepseek-ai/dsh-desktop run package",
    "package:desktop:dir": "pnpm --filter @deepseek-ai/dsh-desktop run package:dir",
    "package:desktop:mac:arm64": "pnpm --filter @deepseek-ai/dsh-desktop run package:mac:arm64",
    "package:desktop:mac:arm64:dir": "pnpm --filter @deepseek-ai/dsh-desktop run package:mac:arm64:dir",
    "package:desktop:mac:x64": "pnpm --filter @deepseek-ai/dsh-desktop run package:mac:x64",
    "package:desktop:mac:x64:dir": "pnpm --filter @deepseek-ai/dsh-desktop run package:mac:x64:dir",
    "package:desktop:win:x64": "pnpm --filter @deepseek-ai/dsh-desktop run package:win:x64",
    "package:desktop:win:x64:unsigned": "pnpm --filter @deepseek-ai/dsh-desktop run package:win:x64:unsigned",
    "package:desktop:win:x64:dir": "pnpm --filter @deepseek-ai/dsh-desktop run package:win:x64:dir",
    "upload:mac:arm64": "pnpm --filter @deepseek-ai/dsh-desktop run upload:mac:arm64",
    "upload:mac:x64": "pnpm --filter @deepseek-ai/dsh-desktop run upload:mac:x64",
    "upload:win:x64": "pnpm --filter @deepseek-ai/dsh-desktop run upload:win:x64",
    "upload:latest:mac:arm64": "pnpm --filter @deepseek-ai/dsh-desktop run upload:latest:mac:arm64",
    "upload:latest:mac:x64": "pnpm --filter @deepseek-ai/dsh-desktop run upload:latest:mac:x64",
    "upload:latest:win:x64": "pnpm --filter @deepseek-ai/dsh-desktop run upload:latest:win:x64",
    "clean": "tsx scripts/clean.ts",
    "change-scope": "tsx scripts/change-scope.ts",
    "typecheck": "npm run build:lib:host && npm run typecheck:contracts-ready",
    "typecheck:contracts-ready": "tsc -b tsconfig.client.json",
    "lint": "npm run build:lib:host && npm run lint:contracts-ready",
    "lint:contracts-ready": "tsx scripts/run-oxlint.ts .",
    "lint:fix": "npm run build:lib:host && npm run lint:fix:contracts-ready",
    "lint:fix:contracts-ready": "tsx scripts/run-oxlint.ts . --fix",
    "build:native-system": "tsx native/system/scripts/build.ts --host-addon-only",
    "migrate:sessions-to-v4": "tsx scripts/migrate-sessions-to-v4.ts",
    "publint": "tsx scripts/publint-all.ts",
    "doc-typecheck": "npm run build:lib:host && npm run doc-typecheck:contracts-ready",
    "doc-typecheck:contracts-ready": "tsx scripts/doc-typecheck.ts",
    "verify-built-package-invariants": "node scripts/verify-built-package-invariants.mjs",
    "verify-translation-pairing": "tsx scripts/verify-translation-pairing.ts",
    "gen-tsconfig-paths": "tsx scripts/gen-tsconfig-paths.ts",
    "verify-tsconfig-paths": "tsx scripts/gen-tsconfig-paths.ts --check",
    "gen-cordis-catalog": "tsx scripts/gen-cordis-catalog.ts",
    "verify-cordis-catalog": "tsx scripts/gen-cordis-catalog.ts --check",
    "gen-cordis-api": "tsx scripts/gen-cordis-api.ts",
    "verify-cordis-api": "tsx scripts/gen-cordis-api.ts --check",
    "gen-cordis-inspect-catalog": "tsx scripts/gen-cordis-inspect-catalog.ts",
    "verify-cordis-inspect-catalog": "tsx scripts/gen-cordis-inspect-catalog.ts --check",
    "gen-workflow-guest": "tsx scripts/gen-workflow-guest.ts",
    "verify-workflow-guest": "tsx scripts/gen-workflow-guest.ts --check",
    "gen-session-format-catalog": "tsx scripts/gen-session-format-catalog.ts",
    "verify-session-format-catalog": "tsx scripts/gen-session-format-catalog.ts --check",
    "gen-scoped-events": "node --max-old-space-size=4096 --import tsx/esm scripts/gen-scoped-events.ts",
    "verify-scoped-events": "node --max-old-space-size=4096 --import tsx/esm scripts/gen-scoped-events.ts --check",
    "constraints": "tsx scripts/check-workspace-constraints.ts",
    "publish:npm-baseline": "tsx scripts/publish-npm-baseline.ts",
    "release:dsh": "tsx scripts/release/bump.ts --family dsh",
    "release:vendor": "tsx scripts/release/bump.ts --family vendor",
    "release:verify": "tsx scripts/release/verify.ts",
    "release:pack": "tsx scripts/release/pack.ts",
    "release:verify-packed-install": "tsx scripts/release/verify-packed-install.ts",
    "release:publish": "tsx scripts/release/publish.ts",
    "demo:ptc": "node scripts/demo-ptc.mjs",
    "build:frontend": "pnpm --filter @deepseek-ai/dsh-desktop-frontend run build",
    "package:desktop:mac:arm64:unsigned": "pnpm --filter @deepseek-ai/dsh-desktop run package:mac:arm64:unsigned",
    "package:desktop:mac:x64:unsigned": "pnpm --filter @deepseek-ai/dsh-desktop run package:mac:x64:unsigned"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "workspace:*",
    "@deepseek-ai/dsh-browser-use": "workspace:*",
    "@deepseek-ai/dsh-experimental-browser-use-runtime": "workspace:*",
    "@deepseek-ai/dsh-experimental-browser-use-chrome-devtools-mcp": "workspace:*",
    "@deepseek-ai/dsh-experimental-browser-use-stagehand-native": "workspace:*",
    "@deepseek-ai/dsh-computer-use": "workspace:*",
    "@deepseek-ai/dsh-experimental-computer-use-cua-driver-mcp": "workspace:*",
    "@deepseek-ai/dsh-experimental-computer-use-cua-driver-native": "workspace:*",
    "@deepseek-ai/dsh-mcp-client": "workspace:*",
    "@deepseek-ai/dsh-tool-session-query": "workspace:*",
    "@deepseek-ai/dsh-web-fetch-http": "workspace:*",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.0",
    "eslint-plugin-sonarjs": "^4.1.0",
    "execa": "^10.0.0",
    "extract-zip": "^2.0.1",
    "fflate": "^0.8.2",
    "js-yaml": "^4.2.0",
    "lightningcss": "^1.32.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "pnpm": "11.7.0",
    "publint": "^0.3.21",
    "smol-toml": "^1.7.1",
    "tar": "^7.5.0",
    "tsdown": "^0.22.2",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "@deepseek-ai/dsh-skill-office": "workspace:*",
    "@deepseek-ai/dsh-tool-workspace-dependencies": "workspace:*",
    "@deepseek-ai/dsh-package-manifest": "workspace:*"
  },
  "description": "Aeoth Agent plugin-based agent runtime"
}
