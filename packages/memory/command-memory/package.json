{
  "name": "@deepseek-ai/dsh-command-memory",
  "description": "Human-facing slash command for profile-scoped MEMORY and USER entries",
  "version": "0.2.1-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
