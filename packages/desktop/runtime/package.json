{
  "name": "@deepseek-ai/dsh",
  "description": "Aeoth Agent Desktop runtime: profile composition and lifecycle for the Electron application",
  "version": "0.2.1-alpha.3",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/desktop/runtime"
  },
  "type": "module",
  "files": [
    "lib/*.js",
    "lib/types/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/cordis": "workspace:~",
    "@deepseek-ai/cordis-plugin-include": "workspace:~",
    "@deepseek-ai/cordis-plugin-loader": "workspace:~",
    "@deepseek-ai/cordis-plugin-timer": "workspace:~",
    "@deepseek-ai/dsh-app-boot": "workspace:*",
    "@deepseek-ai/dsh-base": "workspace:*",
    "@deepseek-ai/dsh-desktop-app": "workspace:*",
    "@deepseek-ai/dsh-home-paths": "workspace:*",
    "@deepseek-ai/dsh-http-proxy": "workspace:*",
    "@deepseek-ai/schemastery": "workspace:~",
    "@deepseek-ai/dsh-launch-environment": "workspace:*",
    "@deepseek-ai/dsh-experimental-voice-input-bundle": "workspace:*",
    "@deepseek-ai/dsh-experimental-auto-review": "workspace:*",
    "@deepseek-ai/dsh-experimental-schedule-bundle": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "exports": {
    "./profile-boot": {
      "types": "./lib/types/profile-boot.d.ts",
      "default": "./lib/profile-boot.js"
    },
    "./package.json": "./package.json"
  }
}
